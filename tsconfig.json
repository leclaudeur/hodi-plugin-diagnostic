{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // hodi:sdk, Hodi's components and hooks, typed by the SDK; Node and Express for the server part.
    "types": ["node", "@hodi-app/plugin-sdk/hodi-sdk"]
  },
  "include": ["server", "web", "test"]
}
